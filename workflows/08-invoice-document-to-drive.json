   "parameters": {
    "html": "<!DOCTYPE html>\n<html lang=\"he\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<title>חשבונית {{ $json.InvoiceNumber }}</title>\n<style>\n  body { font-family: Arial, \"Segoe UI\", sans-serif; color: #1d1f20; background: #fff; margin: 0; padding: 40px; direction: rtl; }\n  .sheet { max-width: 760px; margin: 0 auto; border: 1px solid #5980a6; padding: 32px; }\n  .head { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #5980a6; padding-bottom: 16px; }\n  .brand { font-size: 26px; font-weight: 700; color: #5980a6; }\n  .brand small { display: block; font-size: 12px; color: #555; font-weight: 400; margin-top: 4px; }\n  .doc { text-align: left; }\n  .doc h1 { margin: 0; font-size: 22px; }\n  .doc div { font-size: 13px; color: #555; }\n  .meta { display: flex; gap: 40px; margin: 24px 0; font-size: 14px; }\n  .meta b { display: block; color: #555; font-weight: 400; font-size: 12px; }\n  table { width: 100%; border-collapse: collapse; margin-top: 8px; }\n  th, td { padding: 10px 12px; border-bottom: 1px solid #ddd; text-align: right; font-size: 14px; }\n  th { background: #f2f2f3; color: #333; }\n  td.num, th.num { text-align: left; font-variant-numeric: tabular-nums; }\n  .totals { margin-top: 16px; margin-inline-start: auto; width: 320px; }\n  .totals td { border: none; padding: 6px 12px; }\n  .totals tr.grand td { border-top: 2px solid #5980a6; font-size: 18px; font-weight: 700; }\n  .foot { margin-top: 32px; font-size: 12px; color: #666; border-top: 1px solid #ddd; padding-top: 12px; }\n</style>\n</head>\n<body>\n<div class=\"sheet\">\n  <div class=\"head\">\n    <div class=\"brand\">אלקטרו-פלוס בע\"מ<small>ח.פ. 51-000000-0 · רח' הטכנולוגיה 1, תל אביב · 03-0000000</small></div>\n    <div class=\"doc\"><h1>חשבונית מס</h1><div>מספר {{ $json.InvoiceNumber }}</div><div>מקור</div></div>\n  </div>\n  <div class=\"meta\">\n    <div><b>לכבוד</b>לקוח מס' {{ $json.CustomerId }}</div>\n    <div><b>תאריך הפקה</b>{{ $now.setZone(\"Asia/Jerusalem\").toFormat(\"dd/MM/yyyy\") }}</div>\n    <div><b>תאריך יצירה</b>{{ DateTime.fromISO($json.Created).setZone(\"Asia/Jerusalem\").toFormat(\"dd/MM/yyyy\") }}</div>\n  </div>\n  <table>\n    <thead><tr><th>#</th><th>פירוט</th><th class=\"num\">סכום לפני מע\"מ</th></tr></thead>\n    <tbody><tr><td>1</td><td>מוצרים ושירותים — לפי הזמנה</td><td class=\"num\">{{ Number($json.Amount).toLocaleString(\"he-IL\", { minimumFractionDigits: 2 }) }} ₪</td></tr></tbody>\n  </table>\n  <table class=\"totals\">\n    <tr><td>סה\"כ לפני מע\"מ</td><td class=\"num\">{{ Number($json.Amount).toLocaleString(\"he-IL\", { minimumFractionDigits: 2 }) }} ₪</td></tr>\n    <tr><td>מע\"מ 18%</td><td class=\"num\">{{ Number($json.VatAmount).toLocaleString(\"he-IL\", { minimumFractionDigits: 2 }) }} ₪</td></tr>\n    <tr class=\"grand\"><td>סה\"כ לתשלום</td><td class=\"num\">{{ Number($json.Total).toLocaleString(\"he-IL\", { minimumFractionDigits: 2 }) }} ₪</td></tr>\n  </table>\n  <div class=\"foot\">מסמך זה הופק אוטומטית על ידי מערכת ERP-AI. תנאי תשלום: שוטף + 30. תודה שקניתם באלקטרו-פלוס.</div>\n</div>\n</body>\n</html>"
   }
