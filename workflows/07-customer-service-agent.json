  {
   "id": "624df6e2-42c5-4798-acc9-130d5e09bd73",
   "name": "סוכן שירות לקוחות",
   "type": "@n8n/n8n-nodes-langchain.agent",
   "typeVersion": 3.1,
   "position": [
    352,
