    "emailType": "html",
    "message": "=<div dir=\"rtl\" style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;color:#1d1f20\"><div style=\"background:#5980a6;color:#fff;padding:20px 24px;font-size:20px;font-weight:700\">אלקטרו-פלוס בע\"מ</div><div style=\"padding:24px;border:1px solid #ddd;border-top:none\"><p>שלום {{ $json.Name }},</p><p>תודה על ההזמנה! החשבונית שלך מוכנה.</p><table style=\"border-collapse:collapse;margin:16px 0;width:100%\"><tr><td style=\"padding:8px;border-bottom:1px solid #eee\">מספר חשבונית</td><td style=\"padding:8px;border-bottom:1px solid #eee;text-align:left\"><b>{{ $('שיטוח חשבונית').item.json.InvoiceNumber }}</b></td></tr><tr><td style=\"padding:8px;border-bottom:1px solid #eee\">סכום לפני מע\"מ</td><td style=\"padding:8px;border-bottom:1px solid #eee;text-align:left\">{{ Number($('שיטוח חשבונית').item.json.Amount).toLocaleString(\"he-IL\") }} ₪</td></tr><tr><td style=\"padding:8px;border-bottom:1px solid #eee\">מע\"מ 18%</td><td style=\"padding:8px;border-bottom:1px solid #eee;text-align:left\">{{ Number($('שיטוח חשבונית').item.json.VatAmount).toLocaleString(\"he-IL\") }} ₪</td></tr><tr><td style=\"padding:8px;font-size:18px\"><b>סה\"כ לתשלום</b></td><td style=\"padding:8px;text-align:left;font-size:18px\"><b>{{ Number($('שיטוח חשבונית').item.json.Total).toLocaleString(\"he-IL\") }} ₪</b></td></tr></table><p style=\"text-align:center;margin:24px 0\"><a href=\"{{ $('שיטוח חשבונית').item.json.PdfUrl }}\" style=\"background:#5980a6;color:#fff;padding:12px 28px;text-decoration:none;font-weight:700;display:inline-block\">לצפייה בחשבונית</a></p><p style=\"color:#666;font-size:13px\">ההזמנה בהכנה ותצא למשלוח בהקדם. לשאלות — השיבו למייל זה או פנו לבוט שירות הלקוחות שלנו בטלגרם.</p></div><div style=\"padding:12px 24px;font-size:12px;color:#888\">אלקטרו-פלוס בע\"מ · מסמך זה נוצר אוטומטית על ידי מערכת ERP-AI</div></div>",
